PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=vila_waitlist
CLIENT_ORIGIN=http://localhost:3000
NODE_ENV=development
TRUSTED_PROXY_IPS=loopback

# Resend API key and sender on a domain you have verified in Resend
RESEND_API_KEY=re_replace_with_your_api_key
EMAIL_FROM="VILA <hello@your-verified-domain.com>"

# Absolute public URL in links inside emails. Set to the real deployed website in production.
PUBLIC_APP_URL=http://localhost:3000
